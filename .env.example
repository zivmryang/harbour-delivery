# Copy to .env. Never commit .env or place API secrets in VITE_* variables.
HOST=127.0.0.1
PORT=8787
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
AI_TIMEOUT_MS=90000
# Separate model for document extraction and project handover drafts.
# Install explicitly: ollama pull qwen3:8b. Briefing/extraction models stay separate.
HANDOVER_MODEL=qwen3:8b
# Jobs: one active, eight cached, 30-minute expiry, 15-minute overall deadline.
# Each handover model call is capped at 180 seconds; cancellation aborts requests.

# Optional OpenAI provider. Choose an account-supported model with Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional account-supported override for handover; falls back to OPENAI_MODEL.
HANDOVER_OPENAI_MODEL=

# Required for non-loopback hosting; use a unique random value of at least 24 chars.
AI_GATEWAY_TOKEN=
# Exact frontend origins, comma-separated, no paths; local Vite origins already allowed.
ALLOWED_ORIGIN=

# Optional adapter-enabled MLX server, for record extraction (not briefing).
MLX_BASE_URL=http://127.0.0.1:8080/v1
# Display and /v1/models health-check id only; NOT the inference request model.
# The gateway hardcodes request model=default_model so the CLI-loaded LoRA is used.
MLX_MODEL=mlx-community/Qwen3-0.6B-4bit
